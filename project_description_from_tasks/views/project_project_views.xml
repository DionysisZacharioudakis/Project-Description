<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_description_dialog_view" model="ir.ui.view">
        <field name="name">project.project.description.dialog</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form string="Project Description" class="o_project_description_dialog">
                <sheet>
                    <div class="oe_title mb-3">
                        <h2>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h2>
                    </div>
                    <field
                        name="description"
                        nolabel="1"
                        options="{'resizable': false}"
                        placeholder="Add the project's description, instructions, notes, or useful links here..."
                    />
                </sheet>
            </form>
        </field>
    </record>
</odoo>

