<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t
        t-name="project_description_from_tasks.ProjectTaskControlPanel"
        t-inherit="project.ProjectTaskControlPanel"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('o_embedded_actions')]//button[hasclass('o_draggable')]" position="attributes">
            <attribute name="t-att-class">{
                'active': isProjectDescriptionAction(action)
                    ? projectDescription.open
                    : state.embeddedInfos.currentEmbeddedAction?.id === action.id,
            }</attribute>
        </xpath>
        <xpath expr="//Breadcrumbs/t[@t-set-slot='breadcrumb-status-indicator']/t[@t-slot='control-panel-status-indicator']" position="after">
            <div
                t-if="projectDescription.open and projectDescription.loaded"
                class="o_form_status_indicator d-md-flex align-items-center align-self-md-end me-auto"
            >
                <div
                    class="o_form_status_indicator_buttons d-flex"
                    t-att-class="{ invisible: !projectDescription.dirty }"
                >
                    <button
                        type="button"
                        class="o_form_button_save btn btn-light border-0 px-1 py-0 lh-sm"
                        data-hotkey="s"
                        t-att-disabled="projectDescription.saving"
                        t-on-click.stop="saveProjectDescription"
                        data-tooltip="Save manually"
                        aria-label="Save manually"
                    >
                        <i
                            class="fa fa-fw"
                            t-att-class="projectDescription.saving ? 'fa-spinner fa-spin' : 'fa-cloud-upload'"
                        />
                    </button>
                    <button
                        type="button"
                        class="o_form_button_cancel btn btn-light border-0 px-1 py-0 lh-sm"
                        data-hotkey="j"
                        t-att-disabled="projectDescription.saving"
                        t-on-click.stop="discardProjectDescriptionChanges"
                        data-tooltip="Discard all changes"
                        aria-label="Discard all changes"
                    >
                        <i class="fa fa-times fa-fw"/>
                    </button>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_control_panel_main')]" position="after">
            <section
                t-if="projectDescription.open and hasCurrentProject()"
                class="o_project_description_inline border rounded bg-white p-3"
            >
                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                    <div class="text-truncate">
                        <strong>Project Description</strong>
                        <span t-if="projectDescription.projectName" class="text-muted ms-2" t-out="projectDescription.projectName"/>
                    </div>
                    <button
                        type="button"
                        class="btn-close flex-shrink-0"
                        aria-label="Close project description"
                        title="Close"
                        t-on-click="toggleProjectDescription"
                ></button>
                </div>
                <div t-if="projectDescription.loading" class="text-muted py-3 text-center">
                    <i class="fa fa-spinner fa-spin me-1"/> Loading description...
                </div>
                <t t-elif="projectDescription.loaded">
                    <Wysiwyg
                        class="'o_project_description_wysiwyg'"
                        contentClass="'o_project_description_editor'"
                        config="getProjectDescriptionEditorConfig()"
                        onLoad.bind="onProjectDescriptionEditorLoad"
                        t-key="projectDescription.editorKey"
                    />
                </t>
            </section>
        </xpath>
    </t>
</templates>

