<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t
        t-name="project_description_from_tasks.ProjectTaskControlPanel"
        t-inherit="project.ProjectTaskControlPanel"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('o_embedded_actions')]/t[@t-call='web.embeddedActionsDropdown']" position="before">
            <button
                t-if="hasCurrentProject()"
                type="button"
                class="btn btn-secondary"
                t-att-class="{ active: projectDescription.open }"
                title="View or edit the project description"
                t-on-click="toggleProjectDescription"
            >
                <i class="fa fa-file-text-o"/>
                <span class="ms-1">Project Description</span>
            </button>
        </xpath>
        <xpath expr="//div[hasclass('o_control_panel_main')]" position="after">
            <section
                t-if="projectDescription.open and hasCurrentProject()"
                class="o_project_description_inline border rounded bg-white p-3"
            >
                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                    <div class="text-truncate">
                        <strong>Project Description</strong>
                        <span t-if="projectDescription.projectName" class="text-muted ms-2" t-out="projectDescription.projectName"/>
                    </div>
                    <button
                        type="button"
                        class="btn-close flex-shrink-0"
                        aria-label="Close project description"
                        title="Close"
                        t-on-click="toggleProjectDescription"
                ></button>
                </div>
                <div t-if="projectDescription.loading" class="text-muted py-3 text-center">
                    <i class="fa fa-spinner fa-spin me-1"/> Loading description...
                </div>
                <t t-elif="projectDescription.loaded">
                    <div
                        t-ref="projectDescriptionEditor"
                        class="o_project_description_editor form-control"
                        contenteditable="true"
                        role="textbox"
                        aria-multiline="true"
                        aria-label="Project Description"
                        data-placeholder="Add the project's description, instructions, notes, or useful links here..."
                    />
                    <div class="d-flex gap-2 mt-2">
                        <button
                            type="button"
                            class="btn btn-primary btn-sm"
                            t-att-disabled="projectDescription.saving"
                            t-on-click="saveProjectDescription"
                        >
                            <i t-if="projectDescription.saving" class="fa fa-spinner fa-spin me-1"/>
                            Save
                        </button>
                        <button
                            type="button"
                            class="btn btn-secondary btn-sm"
                            t-att-disabled="projectDescription.saving"
                            t-on-click="discardProjectDescriptionChanges"
                        >
                            Discard
                        </button>
                    </div>
                </t>
            </section>
        </xpath>
    </t>
</templates>

